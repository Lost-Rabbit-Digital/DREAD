-- SECTION 4: SPAWNING SYSTEM
-- #############################################################################

DREAD_MUTANT_OBJECTS = {
    ghoul: obj_enemy_ghoul,
    ghoul_crystal: obj_enemy_ghoul_2,
    blink: obj_enemy_blink,
    big: obj_enemy_big,
    spider: obj_enemy_spider,
    spine: obj_enemy_spine,
    zombie: obj_enemy_zombie,
    infestation: obj_enemy_infestation
};

DREAD_FAUNA_OBJECTS = {
    boar: obj_enemy_boar,
    boar_zombie: obj_enemy_boar_zombie,
    wolf: obj_enemy_wolf_brown,
    rabbit: obj_enemy_rabbit,
    rat: obj_enemy_rat,
    crow: obj_enemy_crow
};

DREAD_BOSS_OBJECTS = {
    lazar: obj_enemy_human_bandit_boss,
    lazar_guard: obj_enemy_human_bandit_boss_guard
};

DREAD_SpawnStats = {
    total_spawned: 0,
    squads_spawned: 0,
    humans_spawned: 0,
    mutants_spawned: 0,
    fauna_spawned: 0,
    skipped_invalid: 0,
    skipped_safe_start: 0,
    skipped_cap: 0
};

DREAD_ResetSpawnStats = func() {
    DREAD_SpawnStats.total_spawned = 0;
    DREAD_SpawnStats.squads_spawned = 0;
    DREAD_SpawnStats.humans_spawned = 0;
    DREAD_SpawnStats.mutants_spawned = 0;
    DREAD_SpawnStats.fauna_spawned = 0;
    DREAD_SpawnStats.skipped_invalid = 0;
    DREAD_SpawnStats.skipped_safe_start = 0;
    DREAD_SpawnStats.skipped_cap = 0;
};

-- All spawn helpers return the number of enemies actually spawned.

DREAD_SpawnHuman = func(faction, x, y, archetype_name, zone_name) {
    if (DREAD_FACTIONS[faction] == undefined) {
        DREAD_LogError("Unknown faction: " + String(faction));
        return 0;
    }
    if (!DREAD_CanSpawnMore(1)) {
        DREAD_SpawnStats.skipped_cap += 1;
        return 0;
    }
    let pos = DREAD_FindValidSpawnPosition(x, y, 30, 5);
    if (!pos.valid) {
        DREAD_SpawnStats.skipped_invalid += 1;
        return 0;
    }

    let archetype = archetype_name;
    if (archetype == undefined) {
        archetype = DREAD_SelectArchetype();
    }
    let tier = DREAD_GetTier(archetype, zone_name);
    NpcSpawn(DREAD_NpcId(faction, tier, archetype), pos.x, pos.y);

    DREAD.raid_enemies += 1;
    DREAD_SpawnStats.humans_spawned += 1;
    DREAD_SpawnStats.total_spawned += 1;
    DREAD_LogDebug("Spawn", archetype + " " + faction + " (tier " + String(tier) + ") at " + String(pos.x) + "," + String(pos.y));
    return 1;
};

DREAD_SpawnObjectAt = func(obj, x, y, radius) {
    if (!DREAD_CanSpawnMore(1)) {
        DREAD_SpawnStats.skipped_cap += 1;
        return 0;
    }
    let pos = DREAD_FindValidSpawnPosition(x, y, radius, 5);
    if (!pos.valid) {
        DREAD_SpawnStats.skipped_invalid += 1;
        return 0;
    }
    InstanceCreate(pos.x, pos.y, obj);
    DREAD.raid_enemies += 1;
    DREAD_SpawnStats.total_spawned += 1;
    return 1;
};

DREAD_SpawnMutant = func(mutant_type, x, y) {
    let obj = DREAD_MUTANT_OBJECTS[mutant_type];
    if (obj == undefined) {
        obj = DREAD_MUTANT_OBJECTS.ghoul;
    }
    let n = DREAD_SpawnObjectAt(obj, x, y, 30);
    DREAD_SpawnStats.mutants_spawned += n;
    return n;
};

DREAD_SpawnFauna = func(fauna_type, x, y) {
    let obj = DREAD_FAUNA_OBJECTS[fauna_type];
    if (obj == undefined) {
        obj = DREAD_FAUNA_OBJECTS.boar;
    }
    let n = DREAD_SpawnObjectAt(obj, x, y, 50);
    DREAD_SpawnStats.fauna_spawned += n;
    return n;
};

DREAD_SpawnSquad = func(faction, center_x, center_y, size, zone_name) {
    let spawn_radius = 40;
    let squad_cfg = DREAD_SafeGet(DREAD_CONFIG, "squads", {});
    let leader_chance = DREAD_SafeGet(squad_cfg, "leader_chance", 0.3);
    let has_leader = DREAD_RandomFloat() < leader_chance;

    let spawned = 0;
    let i = 0;
    while (i < size) {
        let archetype;
        if ((i == 0) and has_leader) {
            archetype = DREAD_SelectLeaderArchetype();
        } else {
            archetype = DREAD_SelectArchetype();
        }
        let offset_x = center_x + Irandom(spawn_radius * 2) - spawn_radius;
        let offset_y = center_y + Irandom(spawn_radius * 2) - spawn_radius;
        spawned += DREAD_SpawnHuman(faction, offset_x, offset_y, archetype, zone_name);
        i += 1;
    }

    if (spawned > 0) {
        DREAD_SpawnStats.squads_spawned += 1;
    }
    DREAD_LogDebug("Squad", "Spawned squad of " + String(spawned) + " " + faction);
    return spawned;
};

-- spawn_point: { name, x, y, type, faction|mutant_type|fauna_type, min, max, chance }
-- density scales the chance without mutating the shared table.
DREAD_ProcessSpawnPoint = func(spawn_point, zone_name, density, player) {
    let chance = DREAD_SafeGet(spawn_point, "chance", 1.0) * density;
    if (DREAD_RandomFloat() >= chance) {
        return 0;
    }

    if (player != undefined) {
        let safe_radius = DREAD_SafeGet(DREAD_CONFIG, "safe_start_radius", 400);
        if (PointDistance(player.x, player.y, spawn_point.x, spawn_point.y) < safe_radius) {
            DREAD_SpawnStats.skipped_safe_start += 1;
            DREAD_LogDebug("Spawn", "Skipped " + spawn_point.name + " (too close to player)");
            return 0;
        }
    }

    let count = DREAD_RandomRange(DREAD_SafeGet(spawn_point, "min", 1), DREAD_SafeGet(spawn_point, "max", 1));
    count = Round(count * DREAD_GetSpawnMultiplier());
    if (count < 1) {
        count = 1;
    }

    let spawned = 0;
    let i = 0;
    match spawn_point.type {
        case "human" {
            if ((count >= 2) and DREAD_SquadsEnabled()) {
                spawned = DREAD_SpawnSquad(spawn_point.faction, spawn_point.x, spawn_point.y, count, zone_name);
            } else {
                while (i < count) {
                    spawned += DREAD_SpawnHuman(spawn_point.faction,
                        spawn_point.x + Irandom(40) - 20, spawn_point.y + Irandom(40) - 20,
                        undefined, zone_name);
                    i += 1;
                }
            }
        }
        case "mutant" {
            while (i < count) {
                spawned += DREAD_SpawnMutant(spawn_point.mutant_type,
                    spawn_point.x + Irandom(60) - 30, spawn_point.y + Irandom(60) - 30);
                i += 1;
            }
        }
        case "fauna" {
            while (i < count) {
                spawned += DREAD_SpawnFauna(spawn_point.fauna_type,
                    spawn_point.x + Irandom(80) - 40, spawn_point.y + Irandom(80) - 40);
                i += 1;
            }
        }
        else {
            DREAD_LogError("Unknown spawn point type: " + String(spawn_point.type));
        }
    }
    return spawned;
};

DREAD_ExecuteSpawnPoints = func(zone_name, spawn_points) {
    let density = DREAD_GetZoneDensity(zone_name);
    let player = DREAD_GetPlayer();
    let spawned = 0;
    let i = 0;
    while (i < ArrayLength(spawn_points)) {
        spawned += DREAD_ProcessSpawnPoint(spawn_points[i], zone_name, density, player);
        i += 1;
    }
    DREAD_Log(zone_name + " spawning complete. Total: " + String(spawned));
    return spawned;
};

-- #############################################################################
-- SECTION 5: INVASION SYSTEM
-- #############################################################################
-- Timers count frames (the game runs at 60 steps per second) and only advance
-- while the player is in a known raid zone.

DREAD_Invasion = {
    active: false,
    wave_count: 0,
    timer: 0,
    next_wave_time: 0,
    enemies_this_raid: 0
};

DREAD_GetWaveEnemies = func(zone) {
    match zone {
        case "forest" {
            return [
                { item: obj_bandit_preset_rookie, weight: 50 },
                { item: obj_bandit_preset_skilled, weight: 15 },
                { item: obj_enemy_ghoul, weight: 20 },
                { item: obj_enemy_boar, weight: 15 }
            ];
        }
        case "makeshift_camp" {
            return [
                { item: obj_bandit_preset_skilled, weight: 30 },
                { item: obj_green_army_preset_rookie, weight: 30 },
                { item: obj_hunter_preset_rookie, weight: 25 },
                { item: obj_enemy_ghoul, weight: 15 }
            ];
        }
        case "industrial_area" {
            return [
                { item: obj_green_army_preset_skilled, weight: 35 },
                { item: obj_bandit_preset_expert, weight: 25 },
                { item: obj_enemy_blink, weight: 25 },
                { item: obj_enemy_ghoul_2, weight: 15 }
            ];
        }
        case "swamp" {
            return [
                { item: obj_enemy_spider, weight: 30 },
                { item: obj_enemy_ghoul, weight: 25 },
                { item: obj_crimson_preset_rookie, weight: 25 },
                { item: obj_enemy_blink, weight: 20 }
            ];
        }
        case "mall" {
            return [
                { item: obj_watcher_preset_skilled, weight: 35 },
                { item: obj_crimson_preset_skilled, weight: 30 },
                { item: obj_enemy_spine, weight: 20 },
                { item: obj_enemy_big, weight: 15 }
            ];
        }
        else {
            return [
                { item: obj_bandit_preset_skilled, weight: 50 },
                { item: obj_enemy_ghoul, weight: 50 }
            ];
        }
    }
};

DREAD_SpawnNearPlayer = func(obj, chase) {
    if (obj == undefined) {
        return 0;
    }
    if (!DREAD_CanSpawnMore(1)) {
        DREAD_SpawnStats.skipped_cap += 1;
        return 0;
    }
    NpcObjectSpawnNearPlayer(obj, 1, chase);
    DREAD.raid_enemies += 1;
    DREAD_SpawnStats.total_spawned += 1;
    return 1;
};

DREAD_SpawnWave = func(zone) {
    let inv_cfg = DREAD_GetInvasionConfig();
    let count = DREAD_RandomRange(DREAD_SafeGet(inv_cfg, "min_enemies", 1), DREAD_SafeGet(inv_cfg, "max_enemies", 3));
    count = Round(count * DREAD_GetSpawnMultiplier());
    if (count < 1) {
        count = 1;
    }

    let enemies = DREAD_GetWaveEnemies(zone);
    let spawned = 0;
    let i = 0;
    while (i < count) {
        spawned += DREAD_SpawnNearPlayer(DREAD_WeightedRandom(enemies), true);
        i += 1;
    }

    DREAD_Invasion.enemies_this_raid += spawned;
    DREAD_Invasion.wave_count += 1;
    DREAD_Log("Invasion wave " + String(DREAD_Invasion.wave_count) + ": " + String(spawned) + " enemies");
    return spawned;
};

DREAD_SpawnChaosWave = func(zone) {
    let count = DREAD_RandomRange(1, 3);
    let spawned = 0;
    let i = 0;
    while (i < count) {
        -- undefined means "native roll", which adds nothing extra.
        spawned += DREAD_SpawnNearPlayer(DREAD_GetChaosEnemyForZone(zone), true);
        i += 1;
    }
    DREAD_Invasion.enemies_this_raid += spawned;
    return spawned;
};

DREAD_InitInvasion = func() {
    let inv_cfg = DREAD_GetInvasionConfig();
    DREAD_Invasion.wave_count = 0;
    DREAD_Invasion.timer = 0;
    DREAD_Invasion.enemies_this_raid = 0;
    DREAD_Invasion.active = DREAD_SafeGet(inv_cfg, "enabled", false) and (DREAD_SafeGet(inv_cfg, "max_waves", 0) > 0);
    if (!DREAD_Invasion.active) {
        return;
    }
    let first_delay = DREAD_SafeGet(inv_cfg, "first_wave_delay_seconds", 300);
    DREAD_Invasion.next_wave_time = first_delay * 60;
    DREAD_Log("Invasions armed. First wave in " + String(first_delay) + " seconds");
};

DREAD_UpdateInvasion = func(zone) {
    if (!DREAD_Invasion.active) {
        return;
    }
    let inv_cfg = DREAD_GetInvasionConfig();
    if (DREAD_Invasion.wave_count >= DREAD_SafeGet(inv_cfg, "max_waves", 0)) {
        DREAD_Invasion.active = false;
        DREAD_Log("Invasions complete: " + String(DREAD_Invasion.enemies_this_raid) + " enemies over " + String(DREAD_Invasion.wave_count) + " waves");
        return;
    }

    DREAD_Invasion.timer += 1;
    if (DREAD_Invasion.timer >= DREAD_Invasion.next_wave_time) {
        DREAD_SpawnWave(zone);
        if (DREAD_ChaosEnabled() and (DREAD_RandomFloat() < 0.2)) {
            DREAD_SpawnChaosWave(zone);
        }
        let interval = DREAD_SafeGet(inv_cfg, "wave_interval_seconds", 240);
        DREAD_Invasion.next_wave_time = DREAD_Invasion.timer + (interval * 60);
    }
};

DREAD_StopInvasion = func() {
    DREAD_Invasion.active = false;
};

