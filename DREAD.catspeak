-- Returns an enemy object, or undefined for a "native" roll (nothing extra).
DREAD_GetChaosEnemyForZone = func(zone_name) {
    let zone = DREAD_ZONES[zone_name];
    if (zone == undefined) {
        return undefined;
    }
    let roll = Irandom(99);
    let pool = [];
    if (roll < 60) {
        return undefined;
    } else if (roll < 85) {
        pool = zone.chaos_enemies.uncommon;
    } else if (roll < 97) {
        pool = zone.chaos_enemies.rare;
    } else {
        pool = zone.chaos_enemies.anomalous;
    }
    return DREAD_RandomElement(pool);
};

