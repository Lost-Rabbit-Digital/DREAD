-- Spawns a second Lazar camp. Off on "normal" (extra_boss_chance = 0): the
-- vanilla Lazar is a quest target and a duplicate boss is brutal for new players.
FOREST_BOSS_SPAWNS = [
    { name: "Lazar's Camp", x: 700, y: 400, boss: "lazar", guards: 2 }
];

DREAD_ExecuteForestBossSpawns = func() {
    let chance = DREAD_SafeGet(DREAD.preset, "extra_boss_chance", 0);
    let i = 0;
    while (i < ArrayLength(FOREST_BOSS_SPAWNS)) {
        let boss_point = FOREST_BOSS_SPAWNS[i];
        if (DREAD_RandomFloat() < chance) {
            if (DREAD_SpawnObjectAt(DREAD_BOSS_OBJECTS[boss_point.boss], boss_point.x, boss_point.y, 30) > 0) {
                DREAD_Log("BOSS SPAWN: " + boss_point.name);
                let g = 0;
                while (g < boss_point.guards) {
                    DREAD_SpawnObjectAt(DREAD_BOSS_OBJECTS.lazar_guard,
                        boss_point.x + Irandom(60) - 30, boss_point.y + Irandom(60) - 30, 30);
                    g += 1;
                }
            }
        }
        i += 1;
    }
};

-- #############################################################################
-- SECTION 8: MAIN ENTRY POINT
-- #############################################################################

DREAD_Initialize = func() {
    DREAD_LoadConfig();
    DREAD_DefineAllNpcs();
    DREAD.initialized = true;
    DREAD_Log("DREAD v" + DREAD.version + " loaded (" + DREAD.preset_name + ")");
};

DREAD_ExecuteZoneSpawns = func(zone) {
    if (!DREAD_IsZoneEnabled(zone)) {
        DREAD_LogDebug("Zone", zone + " disabled in DREAD_CONFIG");
        return;
    }
    if (zone == "forest") {
        DREAD_ExecuteSpawnPoints("forest", FOREST_SPAWN_POINTS);
        DREAD_ExecuteForestBossSpawns();
    } else {
        let templates = DREAD_ZONE_SPAWN_TEMPLATES[zone];
        if (templates != undefined) {
            DREAD_ExecuteSpawnPoints(zone, templates);
        }
    }

    if (DREAD_ChaosEnabled()) {
        let chaos_count = DREAD_RandomRange(1, 3);
        let i = 0;
        while (i < chaos_count) {
            DREAD_SpawnNearPlayer(DREAD_GetChaosEnemyForZone(zone), false);
            i += 1;
        }
    }
};

DREAD_OnRaidStart = func() {
    if (!DREAD.initialized) {
        return;
    }
    DREAD_StopInvasion();
    DREAD.raid_active = false;
    DREAD.raid_enemies = 0;
    DREAD_ResetSpawnStats();

    let zone = DREAD_GetCurrentZone();
    if (!DREAD_IsRaidZone(zone)) {
        DREAD_LogDebug("Zone", "Room " + String(RoomGetCurrent()) + " is not a known raid zone; DREAD idle");
        return;
    }
    DREAD.raid_active = true;

    DREAD_ExecuteZoneSpawns(zone);
    if (DREAD_IsZoneEnabled(zone)) {
        DREAD_InitInvasion();
    }

    DREAD_Log("Raid start (" + zone + "): " + String(DREAD_SpawnStats.total_spawned)
        + " spawned, " + String(DREAD_SpawnStats.skipped_invalid) + " unwalkable, "
        + String(DREAD_SpawnStats.skipped_safe_start) + " too close to player");
};

DREAD_OnStep = func(player) {
    if (!DREAD.raid_active) {
        return;
    }
    let zone = DREAD_GetCurrentZone();
    -- Interiors and other rooms pause the invasion clock.
    if (!DREAD_IsRaidZone(zone)) {
        return;
    }
    DREAD_UpdateInvasion(zone);

    -- Spawn-mapping helper: F8 shows the room and player position.
    if (DREAD.debug and KeyboardCheckPressed(vk_f8)) {
        ShowMessage("[DREAD] room=" + String(RoomGetCurrent()) + " x=" + String(Round(player.x)) + " y=" + String(Round(player.y)));
    }
};

DREAD_OnRaidEnd = func() {
    DREAD_StopInvasion();
    DREAD.raid_active = false;
};

-- =============================================================================
-- EVENT HOOKS
-- =============================================================================

EventAssignFunction("enter_raid", func() {
    DREAD_OnRaidStart();
});

EventAssignFunction("enter_hub", func() {
    DREAD_OnRaidEnd();
});

EventAssignFunction("player_death", func() {
    DREAD_OnRaidEnd();
});

-- step_end_event rather than step_normal_event: many mods (including the doc
-- example) hook obj_player's step_normal_event, and hooking a different event
-- avoids replacing their script.
ObjectSetScript("obj_player", "step_end_event", func(_inst) {
    DREAD_OnStep(_inst);
});

-- =============================================================================
-- STARTUP
-- =============================================================================

DREAD_Initialize();
