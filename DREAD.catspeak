-- =============================================================================
-- DREAD: Dynamic Randomized Enemy Area Distribution
-- =============================================================================
-- Zero Sievert Spawn Overhaul Mod
-- Author: Lost Rabbit Digital
-- License: MIT
-- Version: 0.3.0
-- =============================================================================
--
-- DREAD enhances Zero Sievert's spawn system with:
--   - New spawn points in previously empty areas
--   - SAIN-inspired enemy archetypes (GigaChad, Chad, Rat, Timmy, etc.)
--   - Squad spawning with leaders
--   - Invasion waves during raids
--   - Chaos Mode for cross-zone enemy variety
--
-- IMPORTANT FOR CONTRIBUTORS (Catspeak 3.1.1 scoping):
--   Catspeak functions are NOT closures. Inside a `func`, any name that is not
--   a parameter or a `let` of that same function is looked up in the file's
--   dynamic globals. A top-level `let X = ...` is invisible to functions and
--   reads as `undefined`, which crashes with "value is not a function".
--   So: shared values/functions are declared WITHOUT `let` at the top level,
--   and `let` is only used for locals inside functions.
--   Run `python -I tools/lint_catspeak.py DREAD.catspeak` before shipping.
--
-- =============================================================================

-- #############################################################################
-- SECTION 0: USER CONFIGURATION  (edit this block to customise DREAD)
-- #############################################################################
-- Zero Sievert mods cannot read arbitrary JSON files (FileDataRead reads save
-- data keys, not files), so configuration lives here.

DREAD_CONFIG = {
    -- "tourist" | "normal" | "hardcore" | "nightmare"  (see DREAD_PRESETS below)
    difficulty: "normal",

    -- true = popup log messages and the F8 coordinate logger.
    -- Popups interrupt play; leave this off unless you are mapping spawns.
    debug_mode: false,

    -- Fixed spawn points never fire within this many pixels of the player at
    -- raid start, so nobody gets jumped while the screen fades in.
    safe_start_radius: 400,

    squads: {
        enabled: true,
        min_size: 2,
        max_size: 4,
        leader_chance: 0.3
    },

    -- density: "sparse" (x0.5) | "normal" (x1) | "dense" (x1.5) | "extreme" (x2)
    -- Zones other than Forest still use placeholder coordinates, so they are
    -- off by default until their spawn points are mapped in-game.
    zones: {
        forest: { enabled: true, density: "normal" },
        makeshift_camp: { enabled: false, density: "normal" },
        industrial_area: { enabled: false, density: "normal" },
        swamp: { enabled: false, density: "normal" },
        mall: { enabled: false, density: "normal" },
        zaton: { enabled: false, density: "normal" },
        city: { enabled: false, density: "normal" },
        cnpp: { enabled: false, density: "normal" }
    }
};

