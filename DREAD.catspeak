-- #############################################################################
-- SECTION 1: CORE UTILITIES
-- #############################################################################

DREAD = {
    version: "0.3.0",
    debug: false,
    initialized: false,
    preset: undefined,
    preset_name: "normal",
    raid_active: false,
    raid_enemies: 0
};

-- Logging. ShowMessage opens a popup, so normal logs only show in debug mode.
DREAD_Log = func(message) {
    if (DREAD.debug) {
        ShowMessage("[DREAD] " + String(message));
    }
};

DREAD_LogDebug = func(category, message) {
    if (DREAD.debug) {
        ShowMessage("[DREAD:" + category + "] " + String(message));
    }
};

DREAD_LogError = func(message) {
    ShowMessage("[DREAD ERROR] " + String(message));
};

DREAD_SafeGet = func(obj, key, default_val) {
    if (obj == undefined) {
        return default_val;
    }
    let val = obj[key];
    if (val == undefined) {
        return default_val;
    }
    return val;
};

-- Inclusive integer range.
DREAD_RandomRange = func(min_val, max_val) {
    if (min_val >= max_val) {
        return min_val;
    }
    return Irandom(max_val - min_val) + min_val;
};

-- Float in [0, 1).
DREAD_RandomFloat = func() {
    return Irandom(999) / 1000;
};

-- weighted_items: [{ item, weight }]. Zero-weight items are never picked.
DREAD_WeightedRandom = func(weighted_items) {
    let total_weight = 0;
    let i = 0;
    while (i < ArrayLength(weighted_items)) {
        total_weight += weighted_items[i].weight;
        i += 1;
    }
    if (total_weight <= 0) {
        return weighted_items[0].item;
    }

    let roll = Irandom(total_weight - 1);
    let cumulative = 0;
    i = 0;
    while (i < ArrayLength(weighted_items)) {
        cumulative += weighted_items[i].weight;
        if (roll < cumulative) {
            return weighted_items[i].item;
        }
        i += 1;
    }
    return weighted_items[ArrayLength(weighted_items) - 1].item;
};

DREAD_RandomElement = func(arr) {
    if (ArrayLength(arr) == 0) {
        return undefined;
    }
    return arr[Irandom(ArrayLength(arr) - 1)];
};

-- Returns { x, y, valid }.
DREAD_FindValidSpawnPosition = func(center_x, center_y, radius, max_attempts) {
    if (CollisionWalkable(center_x, center_y)) {
        return { x: center_x, y: center_y, valid: true };
    }
    let attempts = 0;
    while (attempts < max_attempts) {
        let angle = Irandom(359);
        let distance = Irandom(radius);
        let x = center_x + LengthDirX(distance, angle);
        let y = center_y + LengthDirY(distance, angle);
        if (CollisionWalkable(x, y)) {
            return { x: x, y: y, valid: true };
        }
        attempts += 1;
    }
    return { x: center_x, y: center_y, valid: false };
};

-- Returns the player instance or undefined.
DREAD_GetPlayer = func() {
    let players = ObjectGetAllInstances(obj_player);
    if (ArrayLength(players) == 0) {
        return undefined;
    }
    return players[0];
};

DREAD_CanSpawnMore = func(count) {
    let cap = DREAD_SafeGet(DREAD.preset, "max_enemies_per_raid", 30);
    return (DREAD.raid_enemies + count) <= cap;
};

-- =============================================================================
-- ZONE DETECTION
-- =============================================================================
-- Room names verified against the game data: r_forest, r_makeshift_camp,
-- r_industrial_area, r_swamp, r_mall, r_hub. The zaton/city/cnpp room names
-- are unverified (their zones are disabled by default). Any room not listed
-- here (prologue, interiors, base rooms) is "unknown" and DREAD stays idle.

DREAD_GetCurrentZone = func() {
    let room = RoomGetCurrent();

    if (room == "r_forest") { return "forest"; }
    if (room == "r_makeshift_camp") { return "makeshift_camp"; }
    if (room == "r_industrial_area") { return "industrial_area"; }
    if (room == "r_swamp") { return "swamp"; }
    if (room == "r_mall") { return "mall"; }
    if (room == "r_zaton") { return "zaton"; }
    if (room == "r_city") { return "city"; }
    if (room == "r_city_layout") { return "city"; }
    if (room == "r_cnpp") { return "cnpp"; }
    if (room == "r_npp_layout") { return "cnpp"; }
    if (room == "r_hub") { return "hub"; }

    return "unknown";
};

DREAD_IsRaidZone = func(zone) {
    return (zone != "hub") and (zone != "unknown");
};

-- #############################################################################
-- SECTION 2: CONFIGURATION ACCESS
-- #############################################################################

DREAD_LoadConfig = func() {
    DREAD.debug = DREAD_SafeGet(DREAD_CONFIG, "debug_mode", false);

    let name = DREAD_SafeGet(DREAD_CONFIG, "difficulty", "normal");
    let preset = DREAD_PRESETS[name];
    if (preset == undefined) {
        DREAD_LogError("Unknown difficulty '" + String(name) + "', using 'normal'");
        name = "normal";
        preset = DREAD_PRESETS.normal;
    }
    DREAD.preset = preset;
    DREAD.preset_name = name;
};

DREAD_GetSpawnMultiplier = func() {
    return DREAD_SafeGet(DREAD.preset, "spawn_multiplier", 1.0);
};

DREAD_GetZoneConfig = func(zone_name) {
    let zones = DREAD_SafeGet(DREAD_CONFIG, "zones", {});
    return DREAD_SafeGet(zones, zone_name, {});
};

DREAD_IsZoneEnabled = func(zone_name) {
    return DREAD_SafeGet(DREAD_GetZoneConfig(zone_name), "enabled", false);
};

DREAD_GetZoneDensity = func(zone_name) {
    let density = DREAD_SafeGet(DREAD_GetZoneConfig(zone_name), "density", "normal");
    match density {
        case "sparse" { return 0.5; }
        case "normal" { return 1.0; }
        case "dense" { return 1.5; }
        case "extreme" { return 2.0; }
        else { return 1.0; }
    }
};

DREAD_SquadsEnabled = func() {
    return DREAD_SafeGet(DREAD_SafeGet(DREAD_CONFIG, "squads", {}), "enabled", true);
};

DREAD_ChaosEnabled = func() {
    return DREAD_SafeGet(DREAD.preset, "chaos_enabled", false);
};

DREAD_GetInvasionConfig = func() {
    return DREAD_SafeGet(DREAD.preset, "invasions", {});
};

-- #############################################################################
-- SECTION 3: ARCHETYPE SYSTEM
-- #############################################################################
-- Archetypes pick a rung on the vanilla preset ladder relative to the zone, then
-- scale that preset's own HP and aim radius. Values are derived from
-- ZS_vanilla/gamedata/npc_preset.json so DREAD enemies stay in vanilla's range.

DREAD_TIER_NAMES = ["rookie", "intermediate", "skilled", "expert", "veteran", "master"];

DREAD_ARCHETYPE_ORDER = ["gigachad", "chad", "normal", "rat", "timmy"];

-- recoil_modifier > 1 = bigger aim circle = less accurate.
DREAD_ARCHETYPES = {
    gigachad: { name: "GigaChad", base_tier: 3, hp_multiplier: 1.3, recoil_modifier: 0.85 },
    chad: { name: "Chad", base_tier: 2, hp_multiplier: 1.15, recoil_modifier: 0.92 },
    normal: { name: "Normal", base_tier: 1, hp_multiplier: 1.0, recoil_modifier: 1.0 },
    rat: { name: "Rat", base_tier: 0, hp_multiplier: 0.9, recoil_modifier: 1.1 },
    timmy: { name: "Timmy", base_tier: 0, hp_multiplier: 0.8, recoil_modifier: 1.2 }
};

DREAD_FACTION_ORDER = ["bandits", "green_army", "hunters", "watchers", "crimson"];

-- preset: npc_preset.json prefix. faction: the faction name the game expects.
-- Per-tier arrays (rookie..master) copy the vanilla preset values; loot chests
-- use the "normal" roll of the preset's chest tier ("human_<tier>_normal").
DREAD_FACTIONS = {
    bandits: {
        preset: "bandit", faction: "Bandits",
        hp: [45, 45, 55, 55, 65, 65],
        recoil_min: [18, 18, 15, 12, 9, 7],
        recoil_max: [28, 28, 25, 22, 19, 16],
        armor: ["armor_bandit_1", "armor_bandit_2", "armor_bandit_2", "armor_bandit_3", "armor_bandit_3", "armor_bandit_4"],
        chest: ["rookie", "rookie", "intermediate", "expert", "expert", "veteran"],
        xp: [10, 10, 15, 15, 20, 27]
    },
    green_army: {
        preset: "green_army", faction: "Green Army",
        hp: [55, 55, 65, 65, 75, 100],
        recoil_min: [18, 15, 12, 9, 7, 5],
        recoil_max: [28, 25, 22, 19, 16, 13],
        armor: ["armor_faction1_standard_0", "armor_faction1_0", "armor_faction1_0", "armor_faction1_0", "armor_faction1_2", "armor_faction1_2"],
        chest: ["rookie", "intermediate", "skilled", "expert", "veteran", "master"],
        xp: [10, 15, 20, 20, 27, 35]
    },
    hunters: {
        preset: "hunter", faction: "All Enemy",
        hp: [55, 55, 65, 65, 75, 100],
        recoil_min: [18, 15, 12, 9, 7, 5],
        recoil_max: [28, 25, 22, 19, 16, 13],
        armor: ["armor_loner_0", "armor_loner_1", "armor_loner_2", "armor_loner_2", "armor_loner_3", "armor_loner_3"],
        chest: ["rookie", "intermediate", "skilled", "expert", "veteran", "master"],
        xp: [10, 15, 20, 20, 27, 35]
    },
    watchers: {
        preset: "watcher", faction: "Watcher",
        hp: [65, 65, 65, 75, 75, 100],
        recoil_min: [15, 12, 9, 7, 5, 5],
        recoil_max: [25, 22, 19, 16, 13, 13],
        armor: ["armor_watcher_0", "armor_watcher_1", "armor_watcher_1", "armor_watcher_2", "armor_watcher_2", "armor_watcher_3"],
        chest: ["skilled", "expert", "expert", "veteran", "master", "master"],
        xp: [15, 20, 20, 27, 35, 35]
    },
    crimson: {
        preset: "crimson", faction: "Crimson Corporation",
        hp: [55, 55, 65, 65, 75, 100],
        recoil_min: [18, 15, 12, 9, 7, 5],
        recoil_max: [28, 25, 22, 19, 16, 13],
        armor: ["armor_faction2_standard_0", "armor_faction2_0", "armor_faction2_1", "armor_faction2_1", "armor_faction2_2", "armor_faction2_2"],
        chest: ["rookie", "intermediate", "skilled", "expert", "veteran", "master"],
        xp: [10, 15, 20, 20, 27, 35]
    }
};

DREAD_GetArchetype = func(archetype_name) {
    let archetype = DREAD_ARCHETYPES[archetype_name];
    if (archetype == undefined) {
        return DREAD_ARCHETYPES.normal;
    }
    return archetype;
};

DREAD_SelectArchetype = func() {
    let weights = DREAD_SafeGet(DREAD.preset, "archetype_weights", {});
    let weighted = [];
    let i = 0;
    while (i < ArrayLength(DREAD_ARCHETYPE_ORDER)) {
        let name = DREAD_ARCHETYPE_ORDER[i];
        ArrayPush(weighted, { item: name, weight: DREAD_SafeGet(weights, name, 0) });
        i += 1;
    }
    return DREAD_WeightedRandom(weighted);
};

DREAD_SelectLeaderArchetype = func() {
    return DREAD_WeightedRandom([
        { item: "gigachad", weight: 25 },
        { item: "chad", weight: 75 }
    ]);
};

DREAD_GetTier = func(archetype_name, zone_name) {
    let archetype = DREAD_GetArchetype(archetype_name);
    let zone = DREAD_ZONES[zone_name];
    let zone_offset = 0;
    if (zone != undefined) {
        zone_offset = zone.tier_offset;
    }
    let bonus = DREAD_SafeGet(DREAD.preset, "tier_bonus", 0);
    return Clamp(archetype.base_tier + zone_offset + bonus, 0, 5);
};

DREAD_NpcId = func(faction, tier, archetype_name) {
    return "dread_" + faction + "_" + String(tier) + "_" + archetype_name;
};

-- NPC definitions are created once at load time (like vanilla data) and reused
-- for every spawn, instead of creating a new definition per enemy.
DREAD_DefineNpc = func(faction, tier, archetype_name) {
    let fdata = DREAD_FACTIONS[faction];
    let archetype = DREAD_GetArchetype(archetype_name);
    let npc_id = DREAD_NpcId(faction, tier, archetype_name);

    -- NpcCreate clones "loner_novice", which hard-codes the friendly "Loners"
    -- faction, a fixed loot chest, no armor and fixed XP. Override all of them.
    NpcCreate(npc_id);
    NpcSetPreset(npc_id, fdata.preset + "_" + DREAD_TIER_NAMES[tier]);
    NpcSetFaction(npc_id, fdata.faction);
    NpcSetArmor(npc_id, fdata.armor[tier]);
    NpcSetChestDropped(npc_id, "human_" + fdata.chest[tier] + "_normal");
    NpcSetExperience(npc_id, fdata.xp[tier]);
    NpcSetHp(npc_id, Round(fdata.hp[tier] * archetype.hp_multiplier));
    NpcSetRecoilAimRadius(npc_id,
        fdata.recoil_min[tier] * archetype.recoil_modifier,
        fdata.recoil_max[tier] * archetype.recoil_modifier);
};

DREAD_DefineAllNpcs = func() {
    let f = 0;
    while (f < ArrayLength(DREAD_FACTION_ORDER)) {
        let tier = 0;
        while (tier < 6) {
            let a = 0;
            while (a < ArrayLength(DREAD_ARCHETYPE_ORDER)) {
                DREAD_DefineNpc(DREAD_FACTION_ORDER[f], tier, DREAD_ARCHETYPE_ORDER[a]);
                a += 1;
            }
            tier += 1;
        }
        f += 1;
    }
};

