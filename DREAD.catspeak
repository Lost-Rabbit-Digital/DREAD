        -- hard cap on enemies DREAD adds per raid (static spawns + waves)
        max_enemies_per_raid: 20,
        spawn_multiplier: 0.5,
        tier_bonus: 0,
        chaos_enabled: false,
        extra_boss_chance: 0,
        archetype_weights: { gigachad: 0, chad: 5, normal: 25, rat: 30, timmy: 40 },
        invasions: { enabled: false, first_wave_delay_seconds: 0, wave_interval_seconds: 0, max_waves: 0, min_enemies: 0, max_enemies: 0 }
    },
    normal: {
        -- hard cap on enemies DREAD adds per raid (static spawns + waves)
        max_enemies_per_raid: 30,
        spawn_multiplier: 1.0,
        tier_bonus: 0,
        chaos_enabled: false,
        extra_boss_chance: 0,
        archetype_weights: { gigachad: 4, chad: 14, normal: 42, rat: 22, timmy: 18 },
        invasions: { enabled: true, first_wave_delay_seconds: 300, wave_interval_seconds: 240, max_waves: 2, min_enemies: 1, max_enemies: 3 }
    },
    hardcore: {
        -- hard cap on enemies DREAD adds per raid (static spawns + waves)
        max_enemies_per_raid: 50,
        spawn_multiplier: 1.5,
        tier_bonus: 1,
        chaos_enabled: false,
        extra_boss_chance: 0.1,
        archetype_weights: { gigachad: 15, chad: 35, normal: 35, rat: 10, timmy: 5 },
        invasions: { enabled: true, first_wave_delay_seconds: 120, wave_interval_seconds: 180, max_waves: 3, min_enemies: 2, max_enemies: 5 }
    },
    nightmare: {
        -- hard cap on enemies DREAD adds per raid (static spawns + waves)
        max_enemies_per_raid: 70,
        spawn_multiplier: 2.0,
        tier_bonus: 2,
        chaos_enabled: true,
        extra_boss_chance: 0.25,
        archetype_weights: { gigachad: 40, chad: 50, normal: 10, rat: 0, timmy: 0 },
        invasions: { enabled: true, first_wave_delay_seconds: 90, wave_interval_seconds: 150, max_waves: 5, min_enemies: 3, max_enemies: 6 }
    }
